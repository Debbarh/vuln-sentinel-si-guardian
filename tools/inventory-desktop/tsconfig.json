{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./vendor/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "vendor/**/*.ts",
    "vendor/**/*.tsx"
  ]
}
