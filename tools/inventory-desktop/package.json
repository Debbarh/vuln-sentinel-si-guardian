{
  "name": "cyber-skill-inventory-desktop",
  "productName": "Cyber-Skill Collector",
  "version": "0.1.0",
  "private": true,
  "description": "Collecteur local s\u00e9curis\u00e9 Cyber-Skill",
  "author": {
    "name": "Cyber-Skill",
    "email": "no-reply@cyber-skill.com"
  },
  "license": "UNLICENSED",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node ../../scripts/inventory/build-desktop.mjs",
    "start": "electron .",
    "package": "electron-builder --publish never",
    "test": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.66.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "lossless-json": "4.3.4",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.5",
    "@tailwindcss/vite": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6"
  },
  "build": {
    "appId": "com.cyber-skill.inventory.collector",
    "asar": true,
    "files": [
      "build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Cyber-Skill-Collector-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "assets/icon-512.png",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon-512.png"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ]
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  },
  "homepage": "https://cyber-skill.com"
}
